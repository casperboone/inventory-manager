# Rust Food webshop (DIN Online) login
SUPPLIER_BASE_URL=https://b2b-rustfood.dinonline.nl
SUPPLIER_USERNAME=
SUPPLIER_PASSWORD=

# Password for the app itself (HTTP basic auth). Leave empty locally to skip
# the login prompt; always set it when hosting.
APP_PASSWORD=

# Database. A local file during development; a Turso URL when hosted
# (libsql://<name>-<org>.turso.io) with its auth token.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Optional but recommended: a general image search for the picker, which
# matches products far better than the product databases alone. Serper gives
# Google image results; 2500 free queries, no card (serper.dev).
# SERPER_API_KEY=

# Google's own Custom Search JSON API is closed to new customers since 2026;
# these only work if you already had access.
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=

# Optional: rows per request and a cap on the import, handy while testing.
# SUPPLIER_PAGE_SIZE=1000
# SUPPLIER_IMPORT_LIMIT=50
